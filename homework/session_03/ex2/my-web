server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/my-web/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;

    location = /404.html {
        root /var/www/my-web/html;
        internal;
    }
}
